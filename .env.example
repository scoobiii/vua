# ==============================================================================
# VUA (VORTEX UNIVERSAL ADAPTER) & RUNTIME GOVERNANCE - ENVIRONMENT CONFIG
# ==============================================================================

# --- AI Models & LLM Inference ---
# GEMINI_API_KEY: Chave da API do Google Gemini (obrigatória para inferência em nuvem Gemini).
# No AI Studio, injetada automaticamente via painel de Secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENAI_API_KEY: Chave opcional para provedores de LLM compatíveis com a API OpenAI / Groq / OpenRouter.
OPENAI_API_KEY=""

# LOCAL_LLM_URL: URL base do servidor local de inferência (Ollama ou LM Studio).
# Padrão Ollama: http://localhost:11434 | LM Studio: http://localhost:1234/v1
LOCAL_LLM_URL="http://localhost:11434"

# LLAMA_CPP_BASE_URL: URL base para o backend nativo llama.cpp / llama-server (ex: no Termux ou servidor dedicado).
LLAMA_CPP_BASE_URL="http://127.0.0.1:11434"

# --- Aplicação, Ingress & Endpoints ---
# APP_URL: URL pública base da aplicação (injetada automaticamente pelo Cloud Run no AI Studio).
# Utilizada para endpoints MCP, callbacks OAuth, links auto-referenciais e metadados.
APP_URL="https://ais-pre-apgga6bc4qb3ko4kofub3t-30357252941.us-west1.run.app"

# PUBLIC_BASE_URL: URL base pública personalizada para descoberta OAuth e metadados de recurso MCP.
# Se vazia, deriva automaticamente da requisição ou do APP_URL.
PUBLIC_BASE_URL=""

# PORT: Porta do servidor Express (padrão 3000 exigido pelo ambiente).
PORT=3000

# NODE_ENV: Ambiente de execução ('development' para Vite middleware ou 'production' para dist estático).
NODE_ENV="production"

# --- Integração com GitHub ---
# GITHUB_TOKEN: Token de Acesso Pessoal (PAT) do GitHub ou token de GitHub App.
# Permite inspecionar repositórios, consultar branches, PRs e disparar ações governadas.
GITHUB_TOKEN=""

# --- Bluesky / AT Protocol Adapter ---
# BLUESKY_IDENTIFIER: Handle ou e-mail da conta Bluesky (ex: vua.bsky.social ou seu-handle.bsky.social).
BLUESKY_IDENTIFIER=""

# BLUESKY_APP_PASSWORD: App Password gerado no Bluesky (Settings -> App Passwords) - nunca use a senha principal.
BLUESKY_APP_PASSWORD=""

# BLUESKY_SERVICE_URL: URL do serviço AT Protocol (padrão: https://bsky.social).
BLUESKY_SERVICE_URL="https://bsky.social"

# --- Governança, Políticas e Escopo Vortex ---
# VUA_ALLOW_WILDCARD_SCOPE: 'false' por padrão para segurança de produção.
# 'true' permite escopos coringa (*) apenas em ambiente de desenvolvimento/testes.
VUA_ALLOW_WILDCARD_SCOPE="false"

# BASELINE_TOLERANCE: Fator multiplicador de tolerância estatística para gates de latência em ARM64/Termux (ex: 1.5).
BASELINE_TOLERANCE="1.5"

# --- Autenticação & Autorização OAuth para MCP (P0 Security) ---
# VUA_OAUTH_REQUIRED: Exigir token Bearer OAuth para acessar endpoints MCP (/mcp, /sse, /mcp/messages).
# 'true' para blindagem de produção; 'false' para testes locais ou ambientes abertos.
VUA_OAUTH_REQUIRED="true"

# OAUTH_APPROVE_SECRET: Segredo compartilhado exigido pelo formulário /oauth/approve para emissão de código de autorização.
OAUTH_APPROVE_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"

# OAuth state store. Production must use Firestore with Application Default Credentials.
OAUTH_STORE="firestore"
# Optional explicit Google Cloud project; otherwise ADC/Firebase project discovery is used.
GCP_PROJECT="your-gcp-project-id"

# ADMIN_EMAIL: E-mail do administrador para concessão automática de papel 'admin' no Firebase Auth / RBAC.
ADMIN_EMAIL="sobrinhoSJ@gmail.com"

# CORS: exact public origin, never * in production.
CORS_ORIGIN="https://your-public-domain.example"
# Maximum JSON request size.
JSON_BODY_LIMIT="1mb"
